# Copy to .dev.vars for local development. Never commit your key.
# Choose openai or deepseek. Keys are only used by server routes.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Supports image input and structured JSON responses.
DEEPSEEK_MODEL=deepseek-flash
# Optional alternative: set AI_PROVIDER=openai and fill these two values.
OPENAI_API_KEY=
# Set a model available to your account supporting image inputs and structured outputs.
OPENAI_MODEL=
TEACHER_EMAILS=teacher@sites.test

# Trusted ChatGPT identity used only to enable the platform owner.
ADMIN_EMAIL=teacher@sites.test
